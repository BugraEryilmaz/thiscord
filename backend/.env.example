# Copy to backend/.env and run cargo from backend/.
BACKEND_BIND=127.0.0.1:3000
RUST_LOG=info,thiscord_backend=debug
ALLOWED_ORIGINS=http://localhost:1420,http://127.0.0.1:1420,http://tauri.localhost,tauri://localhost
# Uncomment after creating the local database; never commit real credentials.
# Startup applies embedded migrations. Leave unset for liveness-only mode (readiness 503).
# DATABASE_URL=postgres://thiscord:CHANGE_ME@127.0.0.1:5432/thiscord?connect_timeout=3
# Separate database for opt-in integration tests, never the application database.
# TEST_DATABASE_URL=postgres://thiscord:CHANGE_ME@127.0.0.1:5432/thiscord_test?connect_timeout=3
