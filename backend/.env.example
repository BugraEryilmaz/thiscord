# Copy to backend/.env and run cargo from backend/.
# Numeric local IP:port; set the public hostname in PUBLIC_BACKEND_URL and DNS.
BACKEND_BIND=127.0.0.1:3000
# Direct HTTPS: set BOTH PEM paths and use BACKEND_BIND=0.0.0.0:443.
# TLS_CERT_PATH=/etc/letsencrypt/live/thiscord.com.tr/fullchain.pem
# TLS_KEY_PATH=/etc/letsencrypt/live/thiscord.com.tr/privkey.pem
# Send SIGHUP to the backend after renewal, or restart it, to load new certificates.
RUST_LOG=info,thiscord_backend=debug
ALLOWED_ORIGINS=http://localhost:1420,http://127.0.0.1:1420,http://tauri.localhost,tauri://localhost
# Uncomment after creating the local database; never commit real credentials.
# Startup applies embedded migrations. Leave unset for liveness-only mode (readiness 503).
# DATABASE_URL=postgres://thiscord:CHANGE_ME@127.0.0.1:5432/thiscord?connect_timeout=3
# Separate database for opt-in integration tests, never the application database.
# TEST_DATABASE_URL=postgres://thiscord:CHANGE_ME@127.0.0.1:5432/thiscord_test?connect_timeout=3

# Development: verification links and reset codes go to ignored backend/.mail/*.txt.
# Use a private Linux directory if the Windows mount does not enforce Unix modes.
MAIL_MODE=file
# To deliver account emails with Resend, set MAIL_MODE=resend and replace the key.
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM=onboarding@resend.dev
# Use a sender on your verified domain to email other users.
# Origin used in clickable verification links; use your HTTPS backend in production.
PUBLIC_BACKEND_URL=http://localhost:3000
# MAIL_DIRECTORY=/home/YOUR_USER/.local/share/thiscord/mail
# Production email uses implicit TLS (port 465), with retries from a DB outbox.
# MAIL_MODE=smtp
# SMTP_HOST=smtp.example.com
# SMTP_USERNAME=CHANGE_ME
# SMTP_PASSWORD=CHANGE_ME
# SMTP_FROM="Thiscord <noreply@thiscord.com.tr>"

# Google OAuth WEB application credentials, kept ONLY on the backend.
# Register this exact redirect URI in Google's console. See docs/accounts.md.
# GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=CHANGE_ME
# GOOGLE_REDIRECT_URL=http://localhost:3000/api/v1/account/google/callback
# Voice WebRTC (UDP), separate from HTTP. Defaults to an automatically selected
# local IPv4 address and an ephemeral port. Do not set a fixed port for multiple peers.
# THISCORD_VOICE_BIND=172.20.0.2:0
# Local Docker coturn setup: see docs/turn.md. Keep the shared secret out of Git.
# THISCORD_STUN_URL=stun:thiscord.com.tr:3478
# THISCORD_TURN_URL=turn:thiscord.com.tr:3478?transport=udp
# THISCORD_TURN_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
