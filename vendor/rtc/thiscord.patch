+/// THISCORD: in-place encryption must produce exactly what `encrypt_rtp` produces, for
+/// both cipher families, with CSRCs, a header extension, padding and a rollover.
+#[test]
+fn test_rtp_in_place_matches_copying_encryption() -> Result<()> {
+    for (profile, key_len, salt_len) in [
+        (ProtectionProfile::Aes128CmHmacSha1_80, 16, 14),
+        (ProtectionProfile::AeadAes128Gcm, 16, 12),
+    ] {
+        let key: Vec<u8> = (0..key_len as u8).collect();
+        let salt: Vec<u8> = (100..100 + salt_len as u8).collect();
+        let context = || {
+            Context::new(&key, &salt, profile, None, None, test_crypto_provider().crypto())
+        };
+        let (mut copying, mut in_place, mut decrypting) = (context()?, context()?, context()?);
+        for (index, sequence_number) in [65533u16, 65534, 65535, 0, 1, 2].into_iter().enumerate() {
+            let mut header = rtp::Header {
+                version: 2,
+                padding: index % 2 == 1,
+                marker: index == 3,
+                payload_type: 111,
+                sequence_number,
+                timestamp: 960 * index as u32,
+                ssrc: 0x1234_5678,
+                csrc: vec![7, 9],
+                ..Default::default()
+            };
+            header.set_extension(1, Bytes::from_static(&[0x30]))?;
+            let packet = rtp::Packet {
+                header: header.clone(),
+                payload: Bytes::from(vec![index as u8; 20 + index]),
+            };
+            let raw = packet.marshal()?;
+            let expected = copying.encrypt_rtp(&raw)?;
+            let mut buffer = BytesMut::with_capacity(raw.len() + 16);
+            buffer.extend_from_slice(&raw);
+            in_place.encrypt_rtp_in_place(&mut buffer, &header)?;
+            assert_eq!(buffer, expected, "{profile:?} seq {sequence_number}");
+            assert_eq!(decrypting.decrypt_rtp(&buffer)?, raw);
+        }
+    }
+    Ok(())
+}
