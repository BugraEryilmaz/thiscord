+    /// THISCORD: encrypts a marshaled RTP packet in place, appending the auth tag. `header`
+    /// must be the packet's own header. Reserve `len + 16` capacity to avoid a reallocation.
+    ///
+    /// # Errors
+    ///
+    /// As [`Self::encrypt_rtp_with_header`].
+    pub fn encrypt_rtp_in_place(&mut self, packet: &mut BytesMut, header: &rtp::Header) -> Result<()> {
+        let (roc, diff, ovf) = self
+            .get_srtp_ssrc_state(header.ssrc)
+            .next_rollover_count(header.sequence_number);
+        if ovf {
+            // See `encrypt_rtp_with_header` (RFC 3711 section 9.2).
+            return Err(Error::ErrExceededMaxPackets);
+        }
+
+        self.cipher.encrypt_rtp_in_place(packet, header, roc)?;
+
+        self.get_srtp_ssrc_state(header.ssrc)
+            .update_rollover_count(header.sequence_number, diff);
+
+        Ok(())
+    }
