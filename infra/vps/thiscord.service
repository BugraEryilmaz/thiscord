[Unit]
Description=Thiscord backend
After=network-online.target postgresql.service docker.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=simple
User=thiscord
Group=thiscord
WorkingDirectory=/var/lib/thiscord
EnvironmentFile=/etc/thiscord/backend.env
ExecStart=/opt/thiscord/current/thiscord-backend
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
# Planned restarts (deploys, systemctl restart/stop, maintenance) are graceful:
# SIGTERM makes the backend stop admitting voice joins, tell voice and chat
# clients it is restarting (they rejoin the next process on their own), wait up
# to 5 s for rooms to drain and up to 8 s for HTTP requests, then exit. 30 s
# leaves ample margin before systemd's SIGKILL; do not lower it below ~15 s.
KillSignal=SIGTERM
TimeoutStopSec=30
UMask=0077
LimitNOFILE=65536
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/thiscord
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
